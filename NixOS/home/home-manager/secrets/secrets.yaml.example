# SOPS encrypted secrets file
# 
# To use this file:
# 1. Copy secrets.yaml.example to secrets.yaml
# 2. Generate an age key: nix-shell -p age --run "age-keygen -o ~/.config/sops/age/keys.txt"
# 3. Get your public key from the output
# 4. Encrypt the file: sops -e -i secrets.yaml
#
# Or use GPG:
# 1. Generate GPG key: gpg --full-generate-key
# 2. Get your key ID: gpg --list-secret-keys --keyid-format LONG
# 3. Update .sops.yaml with your key ID
# 4. Encrypt: sops -e -i secrets.yaml

# GitHub Personal Access Token (optional - you can also use 'gh auth login')
github-token: "your-github-token-here"

# Add other secrets as needed
# api-key: "your-api-key"
# password: "your-password"
